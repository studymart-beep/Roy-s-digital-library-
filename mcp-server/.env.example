# Server-side only — never commit real values
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=eyJ...
ROYS_ACCESS_TOKEN=

# Hosted MCP (mcp-server/hosted.mjs)
# PORT=8787
# PUBLIC_URL=https://mcp.yourdomain.com  # MUST be HTTPS for remote MCP clients
# OAUTH_REDIRECT_ALLOWLIST=https://chatgpt.com,https://claude.ai,http://127.0.0.1:3000/callback
# CORS_ORIGIN=
#   Leave unset unless a browser page you control needs to call POST /mcp
#   directly. Claude/ChatGPT connect server-to-server and don't need this.
#   Setting it means any XSS in that origin can call every MCP tool with
#   whatever token is in that browser tab's memory.

# Where OAuth codes/tokens/refresh-tokens are persisted (v3.9+).
# Defaults to ./data/oauth-store.json under the process's cwd if unset.
# Only safe for a single server instance — for multiple instances behind a
# load balancer, replace mcp-server/lib/store.mjs with a Redis/Postgres
# backend instead of pointing multiple processes at the same file.
# MCP_OAUTH_STORE_PATH=/var/lib/roys-mcp/oauth-store.json

# REQUIRED for the OAuth store to persist across restarts. Without this set,
# tokens/refresh-tokens are kept in memory only and are never written to
# disk (the server refuses to write plaintext secrets) — every restart logs
# every hosted client out. Generate with: openssl rand -base64 32
# Never commit this value; store it in your host's secret manager / env
# config, not in this file.
# MCP_OAUTH_STORE_KEY=
