# Server-side only — never commit real values
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=eyJ...
ROYS_ACCESS_TOKEN=

# ── Hosted MCP (mcp-server/hosted.mjs on Render) ─────────────────
# PORT is injected by Render; do not hard-code in production.
# PUBLIC_URL MUST be the exact public HTTPS origin of this service
# (no trailing slash). Without this, OAuth + root JSON show localhost.
PUBLIC_URL=https://roys-s-digital-library-mcp.onrender.com

# Comma-separated allowed OAuth redirect origins for ChatGPT / Claude / local tests
OAUTH_REDIRECT_ALLOWLIST=https://chatgpt.com,https://claude.ai

# Leave CORS_ORIGIN unset unless a browser page you control needs POST /mcp
# CORS_ORIGIN=

# Encrypted OAuth token store (required so clients survive restarts)
# Generate: openssl rand -base64 32
MCP_OAUTH_STORE_KEY=

# On Render free tier disk is ephemeral. Prefer a Persistent Disk path if
# you attach one; otherwise tokens reset on every deploy/restart.
# MCP_OAUTH_STORE_PATH=/var/data/oauth-store.json
MCP_OAUTH_STORE_PATH=./data/oauth-store.json
